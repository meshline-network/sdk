<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Meshline</Authors>
    <Description>Client SDK for the Meshline protocol, with self-sovereign accounts, encrypted messaging, groups, channels, relay connectivity, and SQLite persistence.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>meshline;messaging;encrypted-messaging;decentralized;protocol;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/meshline-network/sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meshline-network/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>Meshline</RootNamespace>
    <AssemblyName>Meshline.Sdk</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Nethermind.Multiformats.Address" Version="1.1.10" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meshline.Sdk.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../../assets/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
